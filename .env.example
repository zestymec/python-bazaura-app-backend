# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- App ---------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SITE_URL=https://bazaura.pk
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bazaura

# --- OTP login -------------------------------------------------------------
# Development only: every OTP will be this code. Leave empty in production.
OTP_FIXED_CODE=123456

# --- Delivery & pricing (PKR) ---------------------------------------------
FREE_SHIPPING_THRESHOLD_PKR=10000
STANDARD_DELIVERY_FEE_PKR=199
STANDARD_DELIVERY_ESTIMATE=2-4 working days
EXPRESS_DELIVERY_FEE_PKR=299
EXPRESS_DELIVERY_HOURS=3
EXPRESS_DELIVERY_CITIES=["Lahore"]
GIFT_WRAP_FEE_PKR=0

# --- Image storage (S3 / Cloudflare R2 / MinIO) ----------------------------
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=auto
STORAGE_BUCKET=bazaura-media
STORAGE_PUBLIC_BASE_URL=https://media.bazaura.pk

# --- SMS -------------------------------------------------------------------
# "console" only logs messages. Set a real provider before launch.
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=BAZAURA
